# Global parameters for our analysis
NUM_TOTAL_SPECIES     = 253
NUM_STATES            = 2
NUM_HIDDEN            = 2
NUM_RATES             = NUM_STATES * NUM_HIDDEN
H                     = 0.587405
DATASET               = "C4"

# Read in the observed phylogeny
observed_phylogeny <- readTrees("data/AMAR_20_loci_GTR_3MRCA_reduced_s_s.nex")[1]
data <- readCharacterData("data/C4traits.nex")

# we need to expand the data to the hidden states
data_exp <- data.expandCharacters( NUM_HIDDEN )

# Get the names of the taxa in the tree and the age of the tree. We need these later on.
taxa <- observed_phylogeny.taxa()
tree_length <- observed_phylogeny.treeLength()


# Create some vector for the moves and monitors of this analysis
moves    = VectorMoves()
monitors = VectorMonitors()


####################
# Create the rates #
####################


### First, we create the hidden speciation rates
### change the prior values maybe

log_speciation_hidden_mean ~ dnLognormal(ln(0.1), 0.1)
log_extinction_hidden_mean ~ dnLognormal(ln(0.1), 0.1)


#add some moves here
moves.append( mvScale(log_speciation_hidden_mean, weight=3.0) )
moves.append( mvScale(log_extinction_hidden_mean, weight=3.0) )


### Third, we create the speciation and extinction rates for the observed states
for (i in 1:NUM_STATES) {

    ### Create a loguniform distributed variable for the speciation rate
    speciation_observed[i] ~ dnUniform( 0, 0.8 )
    moves.append( mvScale(speciation_observed[i],lambda=1.0,tune=true,weight=3.0) )

    ### Create a loguniform distributed variable for the speciation rate
    extinction_observed[i] ~ dnUniform( 0, 0.8 )
    moves.append( mvScale(extinction_observed[i],lambda=1.0,tune=true,weight=3.0) )

}

#changed, please check
speciation[1] := speciation_observed[1] * exp(log_speciation_hidden_mean)
speciation[2] := speciation_observed[2] * exp(log_speciation_hidden_mean)
speciation[3] := speciation_observed[1] / exp(log_speciation_hidden_mean)
speciation[4] := speciation_observed[2] / exp(log_speciation_hidden_mean)

extinction[1] := extinction_observed[1] * exp(log_extinction_hidden_mean)
extinction[2] := extinction_observed[2] * exp(log_extinction_hidden_mean)
extinction[3] := extinction_observed[1] / exp(log_extinction_hidden_mean)
extinction[4] := extinction_observed[2] / exp(log_extinction_hidden_mean)


### Finally, we put the observed and hidden rates together
#for (j in 1:NUM_HIDDEN) {
#    for (i in 1:NUM_STATES) {
#        index = i+(j*NUM_STATES)-NUM_STATES
#        speciation[index] := speciation_observed[i] * exp(log_speciation_hidden[j])
#        extinction[index] := extinction_observed[i] * exp(log_extinction_hidden[j])
#    }
#}


#########################################################
# Set up the transition rate matrix for observed states #
#########################################################

# Each transition rate between observed states are drawn
# from an exponential distribution with a mean of 10
# character state transitions over the tree.
# may change to dnUniform
rate_pr := observed_phylogeny.treeLength() / 10
for ( i in 1:(NUM_STATES*(NUM_STATES-1)) ) {
    transition_rates[i] ~ dnExp(rate_pr)
    moves.append( mvScale(transition_rates[i],lambda=0.50,tune=true,weight=3.0) )
}


#########################################################
# Set up the transition rate matrix for hidden states #
#########################################################

# We assume the transitions among the hidden states
# are all equal and drawn from an exponential distriubtion.
# may change to uniform,

for (i in 1:(NUM_HIDDEN * (NUM_HIDDEN - 1))) {
    R[i] ~ dnExponential(rate_pr)
    moves.append( mvScale(R[i],lambda=0.5,tune=true,weight=5.0) )
}

######################################################################
# Create the rate matrix for the combined observed and hidden states #
######################################################################
rate_matrix := fnHiddenStateRateMatrix(transition_rates, R, rescaled=false)



#####################################
# Set up the root state frequencies #
#####################################

### Create a constant variable with the prior probabilities of each rate category at the root.
rate_category_prior ~ dnDirichlet( rep(1,NUM_RATES) )
moves.append( mvBetaSimplex(rate_category_prior,tune=true,weight=2) )
moves.append( mvDirichletSimplex(rate_category_prior,tune=true,weight=2) )


### Create the fix parameter for the age of the root set to the observed age
root <- observed_phylogeny.rootAge()


### rho is the probability of sampling species at the present
### change this
rho <- observed_phylogeny.ntips()/950


#### construct a variable for the tree drawn from a birth death process
timetree ~ dnCDBDP( rootAge           = root,
                    speciationRates   = speciation,
                    extinctionRates   = extinction,
                    Q                 = rate_matrix,
                    delta             = 1.0,
                    pi                = rate_category_prior,
                    rho               = rho,
                    condition         = "survival" )

### clamp the model with the "observed" tree
timetree.clamp( observed_phylogeny )

#why here data_exp, in Bisse it is only data
timetree.clampCharData( data_exp )




#############
# The Model #
#############


### workspace model wrapper ###
#what is the difference of model(timetree) Bisse and model(rate_matrix) Hisse
mymodel = model(rate_matrix)

### set up the monitors that will output parameter values to file and screen
monitors.append( mnModel(filename="output/AMAR_HiSSE_"+DATASET+".log", printgen=10) )
monitors.append( mnJointConditionalAncestralState(tree=timetree, cdbdp=timetree, type="NaturalNumbers", printgen=1, withTips=true, withStartStates=false, filename="output/AMAR_HiSSE_"+DATASET+"_anc_states.log") )
monitors.append( mnStochasticCharacterMap(cdbdp=timetree, printgen=1, filename="output/AMAR_HiSSE_"+DATASET+"_stoch_map.log", include_simmap=true) )
monitors.append( mnScreen(printgen=10, speciation_observed, extinction_observed) )


################
# The Analysis #
################

### workspace mcmc
mymcmc = mcmc(mymodel, monitors, moves, nruns=2, moveschedule="random", combine="mixed")

### run the MCMC
mymcmc.run(generations=10000, tuningInterval=100)


##############################
# Summarize ancestral states #
##############################


anc_states = readAncestralStateTrace("output/AMAR_HiSSE_"+DATASET+"_anc_states.log")
anc_tree = ancestralStateTree(tree=observed_phylogeny,
                              ancestral_state_trace_vector=anc_states,
                              include_start_states=false,
                              file="output/AMAR_HiSSE_"+DATASET+"_anc_states_results.tree",
                              burnin=0.1,
                              summary_statistic="MAP",
                              site=1)



# read in the sampled character histories
anc_states = readAncestralStateTrace("output/AMAR_HiSSE_"+DATASET+"_stoch_map.log")

summarizeCharacterMaps(anc_states,
                       observed_phylogeny,
                       file="output/AMAR_HiSSE_"+DATASET+"_events.tsv",
                       burnin=0.1)

# make summary tree
char_map_tree = characterMapTree(tree=observed_phylogeny,
                 ancestral_state_trace_vector=anc_states,
                 character_file="output/AMAR_HiSSE_"+DATASET+"_stoch_map_character.tree",
                 posterior_file="output/AMAR_HiSSE_"+DATASET+"_stoch_map_posterior.tree",
                 burnin=0.25,
                 num_time_slices=500)

q()
